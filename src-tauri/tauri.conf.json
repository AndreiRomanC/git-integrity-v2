{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Git Integrity",
  "version": "0.1.0",
  "identifier": "com.gitintegrity.desktop",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Git Integrity",
        "width": 1440,
        "height": 900,
        "minWidth": 980,
        "minHeight": 650,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "category": "DeveloperTool",
    "shortDescription": "Visual Git repository client"
  }
}
